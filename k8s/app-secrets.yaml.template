apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
type: Opaque
data:
  APP_KEY: "$APP_KEY"

  DB_HOST: "$DB_HOST"
  DB_PORT: "$DB_PORT"
  DB_DATABASE: "$DB_DATABASE"
  DB_USERNAME: "$DB_USERNAME"
  DB_PASSWORD: "$DB_PASSWORD"

  REDIS_HOST: "$REDIS_HOST"
  REDIS_PASSWORD: null
  REDIS_PORT: "$REDIS_PORT"
  REDIS_URL: "$REDIS_URL"

  FIREWORKS_API_KEY: "$FIREWORKS_API_KEY"
  TOGETHER_API_KEY: "$TOGETHER_API_KEY"

  GOOGLE_CHAT_CLIENT_ID: "$GOOGLE_CHAT_CLIENT_ID"
  GOOGLE_CHAT_CLIENT_SECRET: "$GOOGLE_CHAT_CLIENT_SECRET"
  GOOGLE_CHAT_PROJECT_ID: "$GOOGLE_CHAT_PROJECT_ID"

  GOOGLE_DRIVE_CLIENT_ID: "$GOOGLE_DRIVE_CLIENT_ID"
  GOOGLE_DRIVE_CLIENT_SECRET: "$GOOGLE_DRIVE_CLIENT_SECRET"
  GOOGLE_DRIVE_PROJECT_ID: "$GOOGLE_DRIVE_PROJECT_ID"

  GOOGLE_AUTH_CLIENT_ID: "$GOOGLE_AUTH_CLIENT_ID"
  GOOGLE_AUTH_CLIENT_SECRET: "$GOOGLE_AUTH_CLIENT_SECRET"

  JIRA_APP_ID: "$JIRA_APP_ID"
  JIRA_CLIENT_ID: "$JIRA_CLIENT_ID"
  JIRA_CLIENT_SECRET: "$JIRA_CLIENT_SECRET"

  SLACK_APP_ID: "$SLACK_APP_ID"
  SLACK_CLIENT_ID: "$SLACK_CLIENT_ID"
  SLACK_CLIENT_SECRET: "$SLACK_CLIENT_SECRET"

  LINEAR_CLIENT_ID: "$LINEAR_CLIENT_ID"
  LINEAR_CLIENT_SECRET: "$LINEAR_CLIENT_SECRET"

  GITHUB_APP_ID: "$GITHUB_APP_ID"
  GITHUB_CLIENT_ID: "$GITHUB_CLIENT_ID"
  GITHUB_CLIENT_SECRET: "$GITHUB_CLIENT_SECRET"
  GITHUB_PRIVATE_KEY: "$GITHUB_PRIVATE_KEY"

  GITHUB_AUTH_APP_ID: "$GITHUB_APP_ID"
  GITHUB_AUTH_CLIENT_ID: "$GITHUB_CLIENT_ID"
  GITHUB_AUTH_CLIENT_SECRET: "$GITHUB_CLIENT_SECRET"
  GITHUB_AUTH_PRIVATE_KEY: "$GITHUB_PRIVATE_KEY"