apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
type: Opaque
stringData:
  # Database Configuration (Managed PostgreSQL)
  DB_HOST: "your-managed-postgres-host"
  DB_PORT: "5432"
  DB_DATABASE: "horizontal"
  DB_USERNAME: "your-db-username"
  DB_PASSWORD: "your-db-password"

  # Redis Configuration (Managed Redis)
  REDIS_URL: "your-managed-redis-url"

  # Application
  APP_KEY: "base64:your-app-key-here"
  APP_URL: "https://your-domain.com"

  # LLM Configuration
  FIREWORKS_API_KEY: "your-fireworks-api-key"

  # Graph Database (Managed Memgraph)
  GRAPH_DB_HOST: "your-memgraph-tenant1-host"
  GRAPH_DB_PORT: "7687"
  GRAPH_DB_USER: "horizontal"
  GRAPH_DB_PASSWORD: "password"

  # Google Drive Integration
  GOOGLE_DRIVE_CLIENT_ID: "your-google-drive-client-id"
  GOOGLE_DRIVE_CLIENT_SECRET: "your-google-drive-client-secret"
  GOOGLE_DRIVE_REFRESH_TOKEN: "your-google-drive-refresh-token"
  GOOGLE_DRIVE_ACCESS_TOKEN: "your-google-drive-access-token"

  # Google OAuth
  GOOGLE_CLIENT_ID: "your-google-client-id"
  GOOGLE_CLIENT_SECRET: "your-google-client-secret"
  GOOGLE_PROJECT_ID: "your-google-project-id"

  # Jira Integration
  JIRA_CLIENT_SECRET: "your-jira-client-secret"

  # Linear Integration
  LINEAR_API_TOKEN: "your-linear-api-token"
  LINEAR_CLIENT_ID: "your-linear-client-id"
  LINEAR_CLIENT_SECRET: "your-linear-client-secret"

  # GitHub Integration
  GITHUB_CLIENT_ID: "your-github-client-id"
  GITHUB_CLIENT_SECRET: "your-github-client-secret"
  GITHUB_PRIVATE_KEY: "your-github-private-key"
