# AWS Credentials Secret Template
# This secret stores AWS IAM credentials for External Secrets Operator to access AWS Secrets Manager
#
# IMPORTANT: This file contains sensitive credentials - DO NOT commit the filled version to Git!
#
# Setup:
# 1. Copy this file: cp k8s/aws-credentials-secret.yaml.template k8s/aws-credentials-secret.yaml
# 2. Fill in your AWS credentials below
# 3. Apply: kubectl apply -f k8s/aws-credentials-secret.yaml
# 4. Add k8s/aws-credentials-secret.yaml to .gitignore

apiVersion: v1
kind: Secret
metadata:
  name: aws-credentials
  namespace: default
type: Opaque
stringData:
  access-key-id: "YOUR_AWS_ACCESS_KEY_ID"
  secret-access-key: "YOUR_AWS_SECRET_ACCESS_KEY"
