09375, -0.020843505859375, -0.034271240234375, -0.0121307373046875, 0.00652313232421875, -0.030609130859375, 0.031982421875, -0.03692626953125, 0.0098724365234375, -0.0259246826171875, -0.063232421875, -0.01497650146484375, 0.0016088485717773438, 0.036102294921875, -0.0177459716796875, -0.062744140625, -0.004261016845703125, -0.0019702911376953125, -0.01020050048828125, 0.036468505859375, -0.03973388671875, -0.006511688232421875, 0.00322723388671875, -0.03900146484375, -0.0246734619140625, -0.0279541015625, 0.07586669921875, -0.0164337158203125, 0.01122283935546875, -0.01751708984375, -0.05291748046875, -0.0438232421875, -0.04803466796875, 0.015777587890625, 0.0019388198852539062, 0.00373077392578125, -0.006500244140625, -0.02069091796875, -0.0107574462890625, -0.06103515625, 0.0299835205078125, 0.0288848876953125, -0.04058837890625, -0.00655364990234375, -0.0013856887817382812, -0.0219879150390625, -0.0251617431640625, 0.004550933837890625, 0.0007686614990234375, 0.0124664306640625, 0.067626953125, 0.1134033203125, 0.050262451171875, 0.012542724609375, -0.005199432373046875, 0.01264190673828125, -0.07452392578125, -0.03594970703125, -0.041748046875, -0.05096435546875, -0.040863037109375], `id`: "ac5f5a95-ce7d-4b81-8d10-de7d5ef60d06", `document_type`: "document", `source_document_id`: 6, `text`: "If it was wrong in the first place, it’s wrong today.\r\n\r\n\r\nConsistency is dogshit if you’re repeating the wrong thing.\r\n\r\n\r\nInstead of blindly following rules, you can just question the “status quo” and come up with great ideas.\r\n\r\n\r\nThis is called innovation.\r\n\r\n\r\nInnovation > consistency\r\nCode duplication\r\n“but we already have this 10-line section in another class”\r\n\r\n\r\nMy go-to rules (which you absolutely don’t have to follow) are:\r\n* If the fix is a new function that contains the 10-line section, go for it\r\n* If the new function would need some boolean arguments and if-else statements, don’t go for it\r\n* If the solution would be a new abstraction (interface, abstract class, trait, some design pattern), don’t go for it\r\n\r\n\r\nThe 2nd and 3rd case usually means it’s too early to make that decision. \r\nYou make an abstraction that covers the two use cases that you have right now. The 3rd one that comes in 3 weeks will break the entire thing. \r\n\r\n\r\nUsually, leaving the duplicated code there, and waiting for the 3rd occurrence is a better play. \r\n\r\n\r\nAt that point, you’ll have 33% more information.\r\n\r\n\r\nMore information -> better decisions", `_node_content`: "{\"id_\": \"ac5f5a95-ce7d-4b81-8d10-de7d5ef60d06\", \"embedding\": null, \"metadata\": {\"title\": \"Onboarding/4. Development philosophy\", \"source_type\": \"google_drive\", \"source_url\": null, \"document_chunk_id\": 8, \"source_document_id\": 6, \"document_type\": \"document\"}, \"excluded_embed_metadata_keys\": [\"source_url\", \"document_chunk_id\", \"source_document_id\", \"document_type\"], \"excluded_llm_metadata_keys\": [\"source_type\", \"source_url\", \"document_chunk_id\", \"source_document_id\", \"document_type\"], \"relationships\": {\"1\": {\"node_id\": \"1e92795b-3ea3-40e4-a499-d99c1b67daf7\", \"node_type\": \"4\", \"metadata\": {\"title\": \"Onboarding/4. Development philosophy\", \"source_type\": \"google_drive\", \"source_url\": null, \"document_chunk_id\": 8, \"source_document_id\": 6, \"document_type\": \"document\"}, \"hash\": \"3ed8090d92bf7fc05964efd67df7880abb7a303f4c4bccfa395b213e28158fc4\", \"class_name\": \"RelatedNodeInfo\"}, \"2\": {\"node_id\": \"f39c46b2-b1c9-46de-8f39-ffdbeac16023\", \"node_type\": \"1\", \"metadata\": {\"title\": \"Onboarding/4. Development philosophy\", \"source_type\": \"google_drive\", \"source_url\": null, \"document_chunk_id\": 8, \"source_document_id\": 6, \"document_type\": \"document\"}, \"hash\": \"c477a2bc26b75504665d54227eaf31e293fc7deb2ee66f1b0688d0479d3f553a\", \"class_name\": \"RelatedNodeInfo\"}}, \"metadata_template\": \"{key}: {value}\", \"metadata_separator\": \"\\n\", \"text\": \"\", \"mimetype\": \"text/plain\", \"start_char_idx\": 3649, \"end_char_idx\": 4802, \"metadata_seperator\": \"\\n\", \"text_template\": \"{metadata_str}\\n\\n{content}\", \"class_name\": \"TextNode\"}", `_node_type`: "TextNode", `doc_id`: "1e92795b-3ea3-40e4-a499-d99c1b67daf7", `document_chunk_id`: 8, `document_id`: "1e92795b-3ea3-40e4-a499-d99c1b67daf7", `ref_doc_id`: "1e92795b-3ea3-40e4-a499-d99c1b67daf7", `source_type`: "google_drive", `title`: "Onboarding/4. Development philosophy"});
