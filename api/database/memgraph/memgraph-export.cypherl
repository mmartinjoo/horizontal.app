296875, -0.0145416259765625, -0.0144805908203125, -0.0419921875, 0.048828125, -0.00882720947265625, -0.0067291259765625, -0.036346435546875, 0.07183837890625, -0.0085601806640625, -0.007411956787109375, -0.0214080810546875, 0.01094818115234375, 0.00018298625946044922, 0.0027523040771484375, -0.07452392578125, 0.056884765625, -0.028839111328125, 0.0254058837890625, -0.0155487060546875, -0.053375244140625, -0.04913330078125, 0.0216827392578125, 0.038787841796875, -0.0386962890625, -0.01477813720703125, -0.05316162109375, -0.06182861328125, -0.046630859375, -0.0024967193603515625, -0.0184326171875, -0.008544921875, 0.048614501953125, 0.030487060546875, 0.10638427734375, -0.028350830078125, -0.0136260986328125, 0.00868988037109375, 0.056304931640625, -0.058135986328125, 0.00604248046875, 0.0220947265625, 0.06298828125, 0.01496124267578125, 0.04443359375, 0.0694580078125, 0.00948333740234375, -0.013580322265625, 0.0293121337890625, -0.00970458984375, -0.04736328125, 0.0210113525390625, -0.060760498046875, -0.028167724609375, -0.013519287109375, 0.0440673828125, 0.0031414031982421875, 0.033355712890625, 0.006679534912109375, -0.0203857421875, -0.0164031982421875, 0.0265350341796875, -0.10870361328125, -0.02734375, -0.03253173828125, 0.0164642333984375, -0.003185272216796875, -0.0026035308837890625, 0.033599853515625, -0.0264129638671875, 0.06304931640625, 0.0489501953125, -0.019195556640625, -0.028167724609375, -0.0206298828125, 0.0053558349609375, 0.032989501953125, 0.0078887939453125, 0.0308380126953125, -0.035247802734375, -0.0350341796875, -0.0496826171875, -0.0264434814453125, -0.0262298583984375, -0.02447509765625, -0.07464599609375, 0.02099609375, 0.0059967041015625, -0.03607177734375, 0.03704833984375, -0.0139617919921875, -0.007080078125, -0.048095703125, 0.0244293212890625, -0.034698486328125, 0.0233154296875, 0.0251922607421875, 0.040863037109375, 0.005283355712890625, -0.01239776611328125, 0.005786895751953125, -0.006793975830078125, -0.01372528076171875, 0.00036525726318359375, -0.0255279541015625, 0.0141448974609375, -0.03607177734375, 0.05938720703125, -0.007472991943359375, 0.01010894775390625, -0.031036376953125, -0.039703369140625, -0.015655517578125, 0.020172119140625, 0.04449462890625, -0.0282745361328125, -0.05108642578125, 0.022613525390625, 0.0135498046875, -0.01971435546875, 0.0399169921875, -0.059539794921875, 0.0081787109375, -0.0220794677734375, -0.05352783203125, 0.00695037841796875, -0.018798828125, 0.037445068359375, -0.04400634765625, -0.01806640625, 0.0014801025390625, -0.07147216796875, -0.01079559326171875, -0.0318603515625, -0.047943115234375, 0.02447509765625, -0.049041748046875, 0.02618408203125, 0.033782958984375, 0.020660400390625, -0.0296783447265625, 0.0565185546875, 0.0224609375, -0.03875732421875, 0.031402587890625, 0.028533935546875, -0.02142333984375, -0.01532745361328125, -0.044036865234375, -0.0040435791015625, 0.0188446044921875, 0.032012939453125, 0.06512451171875, 0.0509033203125, 0.03375244140625, -0.004962921142578125, 0.01239013671875, 0.021331787109375, -0.04217529296875, -0.05169677734375, -0.0604248046875, -0.0198211669921875], `id`: "2c32a83a-e309-42c1-80a5-032a60c480eb", `document_type`: "document", `source_document_id`: 4, `text`: "Now think about your home network for a moment. Your phone and laptop know about each other. But they still require a router to communicate.\r\n\r\n\r\nConnecting the VPC and the gateway requires a route table to handle. \r\n\r\n\r\nWhen a lambda sends a request to the outside world and gets a response, the router will make sure that the same lambda gets the response:\r\n  \r\n\r\n________________\r\n\r\n\r\nThe config is quite simple:\r\nRouteTable:\r\n Type: AWS::EC2::RouteTable\r\n Properties:\r\n   VpcId: !Ref VPC\r\n\r\n\r\nInternetRoute:\r\n Type: AWS::EC2::Route\r\n Properties:\r\n   RouteTableId: !Ref RouteTable\r\n   DestinationCidrBlock: 0.0.0.0/0\r\n   GatewayId: !Ref InternetGateway\r\n\r\n\r\nIt defines a route table for the VPC and then a connection between the gateway and the route table.\r\n________________\r\nSubnets & routes tables\r\nThere’s a slight problem with the previous configuration.\r\n\r\n\r\nWe connected the VPC and the gateway via a router.\r\n\r\n\r\nHowever, the VPC contains two subnets.\r\n\r\n\r\nThe router should know about these subnets:\r\n  \r\n\r\n\r\n\r\n________________\r\n\r\n\r\nThis is done by two SubnetRouteTableAssociations:\r\nSubnetARouteTableAssociation:\r\n Type: AWS::EC2::SubnetRouteTableAssociation\r\n Properties:\r\n   SubnetId: !Ref SubnetA\r\n   RouteTableId: !Ref RouteTable\r\n\r\n\r\nSubnetBRouteTableAssociation:\r\n Type: AWS::EC2::SubnetRouteTableAssociation\r\n Properties:\r\n   SubnetId: !Ref SubnetB\r\n   RouteTableId: !Ref RouteTable\r\n\r\n\r\nSubnetA and SubnetB can be accessed by the RouteTable now.\r\n________________\r\n\r\n\r\nSecurity groups\r\nNow, on the network level everything is connected and ready. \r\n\r\n\r\nBut we also need to connect things on the “logical” level. Meaning, we need to directly specify which component has access to which component.\r\n\r\n\r\nThis is done by security groups:\r\n  \r\n\r\n\r\n\r\nIt’s a logical grouping of resources and we can define which groups can access which groups.\r\n\r\n\r\n________________\r\n\r\n\r\nThe database access can entirely be limited to lambda functions:\r\nDatabaseSecurityGroup:\r\n Type: AWS::EC2::SecurityGroup\r\n Properties:\r\n   GroupDescription: Security group for RDS database\r\n   VpcId: !Ref VPC\r\n   SecurityGroupIngress:\r\n     - IpProtocol: tcp\r\n       FromPort: 5432\r\n       ToPort: 5432\r\n       SourceSecurityGroupId: !Ref LambdaSecurityGroup\r\n\r\n\r\nThis config defines a security group that only allows incoming traffic on port 5432 from another security group called LambdaSecurityGroup. This is the database’s sec group.\r\n\r\n\r\nThis one is for the lambdas:\r\nLambdaSecurityGroup:\r\n Type: AWS::EC2::SecurityGroup\r\n Properties:\r\n   GroupDescription: Security group for Lambda functions\r\n   VpcId: !Ref VPC\r\n   SecurityGroupEgress:\r\n     - IpProtocol: -1\r\n       CidrIp: 0.0.0.0/0\r\n\r\n\r\nIt allows outgoing traffic to anywhere.\r\n\r\n\r\nSo lambdas can send requests to anywhere but the database can only receive requests from lambdas.\r\n\r\n\r\n(there’s no need to define inbound traffic for lambdas. They are not http-based services. It’s handled by an API gateway)\r\n\r\n\r\nAwesome.\r\n________________\r\nSubnet groups\r\nThe last component needed is a subnet group.\r\n\r\n\r\nWe defined two subnets in the VPC.\r\n\r\n\r\nBut we also need to configure that the database must use those subnets:\r\nDatabaseSubnetGroup:\r\n Type: AWS::RDS::DBSubnetGroup\r\n Properties:\r\n   DBSubnetGroupDescription: Subnet group for PostgreSQL RDS\r\n   SubnetIds:\r\n     - !Ref SubnetA\r\n     - !Ref SubnetB\r\n\r\n\r\n(how to attach this to the DB is shown in the next page)\r\n\r\n\r\nNow AWS can spin up the database in a VPC on two different subnets using two AZs.\r\n\r\n\r\n  \r\n\r\n________________\r\nThe actual database\r\nFinally, the actual database can be defined (not showing some attributes):\r\nPostgresDatabase:\r\n Type: AWS::RDS::DBInstance\r\n Properties:\r\n   Engine: postgres\r\n   EngineVersion: \'16.3\'\r\n   DBInstanceClass: db.t4g.micro\r\n   AllocatedStorage: 20\r\n   StorageType: gp3\r\n   DBName: horizontal\r\n   DBSubnetGroupName: !Ref DatabaseSubnetGroup\r\n   VPCSecurityGroups:\r\n     - !Ref DatabaseSecurityGroup\r\n   StorageEncrypted: true\r\n\r\n\r\nIt uses the subnet group and the appropriate security group.", `_node_content`: "{\"id_\": \"2c32a83a-e309-42c1-80a5-032a60c480eb\", \"embedding\": null, \"metadata\": {\"title\": \"Onboarding/7. Infrastructure\", \"source_type\": \"google_drive\", \"source_url\": null, \"document_chunk_id\": 5, \"source_document_id\": 4, \"document_type\": \"document\"}, \"excluded_embed_metadata_keys\": [\"source_url\", \"document_chunk_id\", \"source_document_id\", \"document_type\"], \"excluded_llm_metadata_keys\": [\"source_type\", \"source_url\", \"document_chunk_id\", \"source_document_id\", \"document_type\"], \"relationships\": {\"1\": {\"node_id\": \"63c57d8e-7c64-4058-a349-7ebc28d0ae7b\", \"node_type\": \"4\", \"metadata\": {\"title\": \"Onboarding/7. Infrastructure\", \"source_type\": \"google_drive\", \"source_url\": null, \"document_chunk_id\": 5, \"source_document_id\": 4, \"document_type\": \"document\"}, \"hash\": \"79fcce26b0fd7ecac61075aa86c3bebf1c4525d684a958b6cc2c39541a32fa41\", \"class_name\": \"RelatedNodeInfo\"}, \"2\": {\"node_id\": \"36b08775-79d3-4922-879b-0584983482f4\", \"node_type\": \"1\", \"metadata\": {\"title\": \"Onboarding/7. Infrastructure\", \"source_type\": \"google_drive\", \"source_url\": null, \"document_chunk_id\": 5, \"source_document_id\": 4, \"document_type\": \"document\"}, \"hash\": \"14f9e2cf1a056982a2bf8a836d7f62e35653f051e9ecdaf8cc548ac1cb41d571\", \"class_name\": \"RelatedNodeInfo\"}}, \"metadata_template\": \"{key}: {value}\", \"metadata_separator\": \"\\n\", \"text\": \"\", \"mimetype\": \"text/plain\", \"start_char_idx\": 3283, \"end_char_idx\": 7317, \"metadata_seperator\": \"\\n\", \"text_template\": \"{metadata_str}\\n\\n{content}\", \"class_name\": \"TextNode\"}", `_node_type`: "TextNode", `doc_id`: "63c57d8e-7c64-4058-a349-7ebc28d0ae7b", `document_chunk_id`: 5, `document_id`: "63c57d8e-7c64-4058-a349-7ebc28d0ae7b", `ref_doc_id`: "63c57d8e-7c64-4058-a349-7ebc28d0ae7b", `source_type`: "google_drive", `title`: "Onboarding/7. Infrastructure"});
