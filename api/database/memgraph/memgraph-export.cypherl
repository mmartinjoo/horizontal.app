 0.0113372802734375, -0.0560302734375, -0.027587890625, -0.0209197998046875, -0.036865234375, -0.006595611572265625, -0.00927734375, 0.045440673828125, 0.01262664794921875, 0.0207977294921875, -0.0177764892578125, -0.0343017578125, 0.013519287109375, -0.04461669921875, 0.046051025390625, 0.01094818115234375, -0.0465087890625, -0.0232391357421875, -0.0340576171875, 0.02130126953125, 0.0299072265625, -0.0286407470703125, 0.0127105712890625, -0.005237579345703125, -0.04705810546875, -0.007843017578125, -0.016265869140625, 0.046966552734375, -0.020294189453125, -0.00861358642578125, -0.03985595703125, -0.09771728515625, -0.051025390625, -0.038330078125, -0.0028705596923828125, 0.005023956298828125, -0.0413818359375, 0.001270294189453125, 0.007602691650390625, 0.0054168701171875, -0.0325927734375, 0.037445068359375, 0.028167724609375, -0.00925445556640625, 0.036590576171875, 0.0267181396484375, 0.0038604736328125, 0.0039520263671875, -0.0299835205078125, -0.01204681396484375, 0.0074310302734375, 0.06414794921875, 0.10003662109375, 0.055908203125, 0.0296478271484375, 0.014862060546875, 0.06903076171875, -0.024627685546875, -0.045379638671875, -0.0830078125, -0.031219482421875, -0.019256591796875], `id`: "6e08aaeb-7bb3-4d3a-a18b-391781f192bb", `document_type`: "document", `source_document_id`: 2, `text`: "title: Onboarding/6. Google Drive Authorization, body: ﻿Google Drive Authorization\r\nhorizontal.app\r\nAt the moment, Google Drive authorization is not fully implemented. Meaning, you cannot authorize your account by hitting an endpoint in the project. This will change soon.\r\n\r\n\r\nUntil then, this is how you can do it.\r\n\r\n\r\nOpen https://developers.google.com/oauthplayground.\r\n\r\n\r\nIn the top right corner, click the settings icon, check \"Use your own OAuth credentials\" and paste your Client ID and Client Secret:\r\n  \r\n\r\n\r\n\r\nYou can find these information in api project’s .env file:\r\n* GOOGLE_DRIVE_CLIENT_ID\r\n* GOOGLE_DRIVE_CLIENT_SECRET\r\n\r\n\r\nIn step 1 on the left, scroll to \"Drive API v3\", expand it and select everything:\r\n  \r\n\r\n________________\r\n\r\n\r\nClick \"Authorize APIs\" and allow access to your account when prompted. There will be a few warnings, just proceed.\r\nWhen you get to step 2, check \"Auto-refresh the token before it expires\" and click \"Exchange authorization code for tokens\".\r\n  \r\n\r\n\r\n\r\n________________\r\n\r\n\r\nWhen you get to step 3, click on step 2 again and you should see your refresh token.\r\n  \r\n\r\n\r\n\r\nFor this to be working, you must be enabled on the Google App as a test user. If you have authorization issues, that is the problem. Ping me and I’ll fix it.", `_node_content`: "{\"id_\": \"6e08aaeb-7bb3-4d3a-a18b-391781f192bb\", \"embedding\": null, \"metadata\": {\"title\": \"Onboarding/6. Google Drive Authorization\", \"source_type\": \"google_drive\", \"source_url\": null, \"document_chunk_id\": 3, \"source_document_id\": 2, \"document_type\": \"document\"}, \"excluded_embed_metadata_keys\": [\"source_url\", \"document_chunk_id\", \"source_document_id\", \"document_type\"], \"excluded_llm_metadata_keys\": [\"source_type\", \"source_url\", \"document_chunk_id\", \"source_document_id\", \"document_type\"], \"relationships\": {\"1\": {\"node_id\": \"4cc372e0-a651-43f1-8a87-632ce969be9d\", \"node_type\": \"4\", \"metadata\": {\"title\": \"Onboarding/6. Google Drive Authorization\", \"source_type\": \"google_drive\", \"source_url\": null, \"document_chunk_id\": 3, \"source_document_id\": 2, \"document_type\": \"document\"}, \"hash\": \"f3ac6b0364e19bcd225429ae75bdf4d4a4cd1fece453488f6430b8e788d94ea5\", \"class_name\": \"RelatedNodeInfo\"}}, \"metadata_template\": \"{key}: {value}\", \"metadata_separator\": \"\\n\", \"text\": \"\", \"mimetype\": \"text/plain\", \"start_char_idx\": 0, \"end_char_idx\": 1281, \"metadata_seperator\": \"\\n\", \"text_template\": \"{metadata_str}\\n\\n{content}\", \"class_name\": \"TextNode\"}", `_node_type`: "Tex